{
  "name": "Finance",
  "version": "11.0.0",
  "status": "active",
  "domainBlocks": {
    "structure": [
      {
        "label": "Strategy Group",
        "description": "Container block that groups a strategy's building blocks.",
        "container": true,
        "allowedChildren": [
          "Risk Factor"
        ]
      }
    ],
    "boundary": [
      {
        "label": "Budget",
        "properties": [
          {
            "name": "amount",
            "type": "float"
          }
        ],
        "ports": [
          {
            "name": "out",
            "flow": "data"
          }
        ]
      }
    ],
    "operators": [
      {
        "label": "Risk Factor",
        "properties": [
          {
            "name": "threshold",
            "type": "int",
            "required": true
          },
          {
            "name": "risk_model",
            "type": "risk-category"
          },
          {
            "name": "manual_review",
            "type": "boolean"
          }
        ],
        "constraints": [
          {
            "propertyName": "threshold",
            "constraint": ">=",
            "value": "100"
          },
          {
            "propertyName": "threshold",
            "constraint": "<=",
            "value": "1000"
          }
        ],
        "ports": [
          {
            "name": "in",
            "flow": "data"
          },
          {
            "name": "trigger",
            "flow": "control"
          },
          {
            "name": "out",
            "flow": "data"
          }
        ]
      },
      {
        "label": "Portfolio Optimizer",
        "properties": [
          {
            "name": "optimizer",
            "type": "optimizer-algorithm"
          },
          {
            "name": "max_iterations",
            "type": "int",
            "required": true
          },
          {
            "name": "convergence_threshold",
            "type": "float",
            "required": true
          }
        ],
        "ports": [
          {
            "name": "in",
            "flow": "control"
          },
          {
            "name": "out",
            "flow": "data"
          }
        ]
      }
    ]
  },
  "domainEnums": {
